{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Health Buddy extension descriptor examples v1",
  "type": "object", "additionalProperties": false, "required": ["manifest", "cases"],
  "properties": {
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "extensionApi", "kind", "stateSchema", "entrypoints", "scopes", "egress", "secretReferences", "paths"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "extensionApi": {"const": 1}, "stateSchema": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["metric-view", "connector-workflow"]},
        "entrypoints": {"type": "object", "minProperties": 2, "propertyNames": {"enum": ["metric", "view", "connector", "workflow"]}, "additionalProperties": {"type": "string", "pattern": "^src/[a-z_]+\\.(py|js):[a-z_]+$"}},
        "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["records:read", "records:write"]}},
        "egress": {"const": []}, "secretReferences": {"const": []},
        "paths": {"type": "object", "additionalProperties": false, "required": ["source", "assets", "config", "tests", "notes", "state", "migrations"], "properties": {"source": {"const": "src"}, "assets": {"const": "assets"}, "config": {"const": "config"}, "tests": {"const": "tests"}, "notes": {"const": "notes"}, "state": {"const": "state"}, "migrations": {"const": "migrations"}}}
      }
    },
    "cases": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "input", "output"], "properties": {"id": {"type": "string"}, "input": {"type": "object"}, "output": {"type": "object"}}}}
  }
}
