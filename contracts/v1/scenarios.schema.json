{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic Health Buddy relational wire examples v1",
  "type": "object", "additionalProperties": false,
  "required": ["fixtureVersion", "synthetic", "identity", "scenarios"],
  "properties": {
    "fixtureVersion": {"const": 1}, "synthetic": {"const": true},
    "identity": {"$ref": "#/$defs/identity"},
    "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "identity": {"type": "object", "additionalProperties": false, "required": ["installationId", "datasetId", "restoreEpoch"], "properties": {"installationId": {"type": "string", "format": "uuid"}, "datasetId": {"type": "string", "format": "uuid"}, "restoreEpoch": {"type": "string", "format": "uuid"}}},
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rule", "request", "response", "before", "after", "context"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "rule": {"enum": ["read", "capabilities", "write", "retry", "conflict", "stale", "authorization", "pairing", "revoke", "healthkit", "restore", "replacement"]},
        "request": {"type": "object", "additionalProperties": false, "required": ["method", "path", "headers", "body"], "properties": {"method": {"enum": ["GET", "POST", "PUT", "DELETE"]}, "path": {"type": "string"}, "headers": {"type": "object", "additionalProperties": {"type": "string"}}, "body": {"type": ["object", "null"]}}},
        "response": {"type": "object", "additionalProperties": false, "required": ["status", "headers", "body"], "properties": {"status": {"type": "integer", "minimum": 200, "maximum": 599}, "headers": {"type": "object", "additionalProperties": {"type": "string"}}, "body": {"type": "object"}}},
        "before": {"type": "object"}, "after": {"type": "object"}, "context": {"type": "object"}
      }
    }
  }
}
